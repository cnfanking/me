
function main(config) {
  config["proxy-groups"] = config["proxy-groups"] || [];
  config.rules = config.rules || [];

  // ==============================
  // 通用策略组创建 / 更新函数
  // ==============================
  function updateGroup(group) {
    const index = config["proxy-groups"].findIndex(
      g => g.name === group.name
    );

    if (index >= 0) {
      config["proxy-groups"][index] = {
        ...config["proxy-groups"][index],
        ...group
      };
    } else {
      config["proxy-groups"].unshift(group);
    }
  }

  // ==============================
  // 1. Gemini 策略组
  // ==============================
  const geminiIcon = "https://img.remit.ee/i/QermHQN0gKML";

  const sgNodes = (config.proxies || [])
    .filter(p => p.name && p.name.includes("新加坡-流媒体04"))
    .map(p => p.name);

  updateGroup({
    name: "Gemini",
    type: "fallback",
    icon: geminiIcon,
    url: "https://www.gstatic.com/generate_204",
    interval: 300,
    timeout: 3000,
    lazy: false,
    proxies: [
      ...new Set(sgNodes),
      "自动选择"
    ]
  });

  // ==============================
  // 2. GPT 策略组
  // ==============================
  const gptIcon = "";

  const nodeKeywords = [
    "新加坡-流媒体05"
  ];

  const gptNodes = (config.proxies || [])
    .filter(p =>
      p.name &&
      nodeKeywords.some(keyword => p.name.includes(keyword))
    )
    .map(p => p.name);

  updateGroup({
    name: "GPT",
    type: "fallback",
    icon: gptIcon,
    url: "https://www.gstatic.com/generate_204",
    interval: 300,
    timeout: 3000,
    lazy: false,
    proxies: [
      ...new Set(gptNodes),
      "自动选择",
    ]
  });

  // ==============================
  // 3. Gemini 分流规则
  // ==============================
  const geminiRules = [
    "DOMAIN-SUFFIX,gemini.google.com,Gemini",
    "DOMAIN-SUFFIX,ai.google.dev,Gemini",
    "DOMAIN-SUFFIX,aistudio.google.com,Gemini",
    "DOMAIN-SUFFIX,generativelanguage.googleapis.com,Gemini"
  ];

  // ==============================
  // 4. GPT 分流规则
  // ==============================
  const gptRules = [
    "DOMAIN-SUFFIX,chatgpt.com,GPT",
    "DOMAIN-SUFFIX,openai.com,GPT",
    "DOMAIN-SUFFIX,oaistatic.com,GPT",
    "DOMAIN-SUFFIX,oaiusercontent.com,GPT",
    "DOMAIN-SUFFIX,openaiapi-site.azureedge.net,GPT",
    "DOMAIN-SUFFIX,auth0.com,GPT",
    "DOMAIN-SUFFIX,featuregates.org,GPT",
    "DOMAIN-SUFFIX,statsig.com,GPT",
    "DOMAIN-SUFFIX,intercom.io,GPT",
    "DOMAIN-SUFFIX,intercomcdn.com,GPT"
  ];

  // ==============================
  // 5. 统一规则置顶并去重
  // ==============================
  const customRules = [
    ...geminiRules,
    ...gptRules
  ];

  config.rules = [
    ...customRules,
    ...config.rules.filter(
      rule => !customRules.includes(rule)
    )
  ];

  return config;
}
